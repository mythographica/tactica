{
	"name": "@mnemonica/tactica",
	"version": "0.1.15",
	"description": "Type definition generator for Mnemonica — statically analyzes define() calls and emits .tactica/ types, registry, and metadata",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"bin": {
		"tactica": "lib/cli.js"
	},
	"files": [
		"lib/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"prepare": "husky",
		"build": "rm -rf ./lib && npx tsc --pretty && npm run fix-permissions",
		"fix-permissions": "chmod +x lib/cli.js",
		"watch": "npx tsc --pretty -w",
		"test": "TS_NODE_PROJECT=./tsconfig.test.json mocha test/**/*.test.ts",
		"test:coverage": "npx nyc npm test",
		"test:coverage:html": "npx nyc --reporter=html npm test",
		"lint": "npx eslint --fix ./src ./test",
		"lint:check": "npx eslint ./src ./test",
		"use:public": "rm -rf node_modules package-lock.json && npm install mnemonica@latest typeomatica@latest --save && npm install mnemonica@latest --save-dev && npm install mnemonica@latest --save-peer && echo 'Switched to PUBLIC npm dependencies (latest)'",
		"use:local": "node -e \"const fs=require('fs'),p=JSON.parse(fs.readFileSync('package.json','utf8'));p.peerDependencies.mnemonica='file:../core';p.devDependencies.mnemonica='file:../core';p.devDependencies.typeomatica='file:../typeomatica';p.dependencies.mnemonica='file:../core';fs.writeFileSync('package.json',JSON.stringify(p,null,'\\t')+'\\n');console.log('Switched to LOCAL file: dependencies');\""
	},
	"keywords": [
		"mnemonica",
		"typescript",
		"codegen",
		"types",
		"type-generator",
		"ast"
	],
	"author": "went.out@gmail.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mythographica/tactica.git"
	},
	"bugs": {
		"url": "https://github.com/mythographica/tactica/issues"
	},
	"homepage": "https://github.com/mythographica/tactica#readme",
	"license": "MIT",
	"peerDependencies": {
		"mnemonica": "^1.2.8",
		"typescript": "^5.0.0 || ^6.0.0"
	},
	"devDependencies": {
		"@istanbuljs/nyc-config-typescript": "^1.0.2",
		"@types/chai": "^4.3.20",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.19.43",
		"@typescript-eslint/eslint-plugin": "^8.68.0",
		"@typescript-eslint/parser": "^8.68.0",
		"chai": "^4.5.0",
		"eslint": "^9.39.5",
		"eslint-plugin-mocha": "^10.5.0",
		"eslint-plugin-no-arrow-this": "^1.2.0",
		"globals": "^15.15.0",
		"husky": "^9.1.7",
		"mocha": "^8.4.0",
		"nyc": "^18.0.0",
		"ts-node": "^10.9.2",
		"typeomatica": "^0.3.62",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@types/chokidar": "^2.1.7",
		"chokidar": "^3.6.0",
		"mnemonica": "^1.2.8"
	}
}
